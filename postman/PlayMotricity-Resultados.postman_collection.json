{
  "info": {
    "name": "PlayMotricity - API Completa",
    "description": "Colección completa de pruebas para PlayMotricity: Autenticación JWT, Perfiles Infantiles (validación de regla de edad 2-6 años), Actividades motrices, Asignaciones de actividades a perfiles, Registro y validación de Resultados, y Manejo exhaustivo de Errores (400, 401, 403, 404, 409).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticación y Seguridad",
      "item": [
        {
          "name": "Login docente (Obtener Token JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Retorna token JWT\", () => pm.expect(res.token).to.be.a('string').and.not.empty);",
                  "pm.test(\"Rol es DOCENTE\", () => pm.expect(res.usuario.rol).to.eql('DOCENTE'));",
                  "pm.environment.set(\"tokenDocente\", res.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"docente@playmotricity.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Login padre / acudiente (Obtener Token JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Retorna token JWT\", () => pm.expect(res.token).to.be.a('string').and.not.empty);",
                  "pm.test(\"Rol es PADRE\", () => pm.expect(res.usuario.rol).to.eql('PADRE'));",
                  "pm.environment.set(\"tokenPadre\", res.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"padre@playmotricity.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Consultar Resumen Perfil Docente (/api/docente/resumen)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Contiene datos de docente\", () => {",
                  "  pm.expect(res.nombre).to.be.a('string');",
                  "  pm.expect(res.correo).to.eql('docente@playmotricity.com');",
                  "  pm.expect(res.institucion).to.be.a('string');",
                  "});"
                ]
