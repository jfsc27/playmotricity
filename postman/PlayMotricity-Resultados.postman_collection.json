{
  "info": {
    "name": "PlayMotricity - Regla de resultados",
    "description": "Valida SUB-32 (implementar regla de resultados). Antes de ejecutar: correr postman/datos-prueba-resultados.sql en la base de datos y tener el backend en marcha. Ejecutar la colección completa en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "Login docente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"tokenDocente\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"docente@playmotricity.com\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Login padre",
          "event": [
            {
              "listen": "test",
              "script": {
