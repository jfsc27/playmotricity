            "body": {
              "mode": "raw",
              "raw": "{\n  \"puntaje\": 40,\n  \"precision\": 55.5,\n  \"tiempoEjecucionSeg\": 60,\n  \"completada\": false\n}"
            }
          }
        },
        {
          "name": "404 - Asignación inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensaje descriptivo\", () => pm.expect(pm.response.json().mensaje).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/asignaciones/00000000-0000-0000-0000-000000000000/resultados",
              "host": ["{{baseUrl}}"],
              "path": ["asignaciones", "00000000-0000-0000-0000-000000000000", "resultados"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"puntaje\": 80,\n  \"precision\": 85,\n  \"tiempoEjecucionSeg\": 90,\n  \"completada\": true\n}"
            }
