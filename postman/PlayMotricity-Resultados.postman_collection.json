    {
      "name": "5. Manejo de Errores y Validaciones",
      "item": [
        {
          "name": "409 - Asignación ya completada no permite nuevos resultados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Mensaje de error presente\", () => pm.expect(pm.response.json().mensaje).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
