    {
      "name": "1. Flujo correcto (SUB-32.1, 32.2, 32.3)",
      "item": [
        {
          "name": "Consultar asignación (PENDIENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estado inicial PENDIENTE (ejecuta antes datos-prueba-resultados.sql)\", () => pm.expect(pm.response.json().estado).to.eql(\"PENDIENTE\"));",
                  "pm.test(\"Sin resultado todavía\", () => pm.expect(pm.response.json().resultado).to.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/asignaciones/{{asignacionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "asignaciones",
                "{{asignacionId}}"
              ]
            }
          }
        },
        {
          "name": "Registrar intento NO completado → EN_PROGRESO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Asignación pasa a EN_PROGRESO\", () => pm.expect(r.estadoAsignacion).to.eql(\"EN_PROGRESO\"));",
                  "pm.test(\"Guarda los datos enviados\", () => { pm.expect(r.puntaje).to.eql(40); pm.expect(r.completada).to.eql(false); });",
                  "pm.environment.set(\"resultadoId\", r.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/asignaciones/{{asignacionId}}/resultados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "asignaciones",
                "{{asignacionId}}",
                "resultados"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"puntaje\": 40,\n  \"precision\": 55.5,\n  \"tiempoEjecucionSeg\": 60,\n  \"completada\": false\n}"
            }
          }
        },
        {
          "name": "Registrar intento completado → COMPLETADA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Asignación pasa a COMPLETADA\", () => pm.expect(r.estadoAsignacion).to.eql(\"COMPLETADA\"));",
                  "pm.test(\"Reemplaza el intento anterior (mismo resultado)\", () => pm.expect(r.id).to.eql(pm.environment.get(\"resultadoId\")));",
                  "pm.test(\"Guarda puntaje, precisión y tiempo\", () => { pm.expect(r.puntaje).to.eql(85.5); pm.expect(r.precision).to.eql(90); pm.expect(r.tiempoEjecucionSeg).to.eql(120); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/asignaciones/{{asignacionId}}/resultados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "asignaciones",
                "{{asignacionId}}",
                "resultados"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"puntaje\": 85.5,\n  \"precision\": 90,\n  \"tiempoEjecucionSeg\": 120,\n  \"completada\": true\n}"
            }
          }
        },
        {
          "name": "Consultar asignación (COMPLETADA con resultado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test(\"Estado COMPLETADA en la base de datos\", () => pm.expect(a.estado).to.eql(\"COMPLETADA\"));",
                  "pm.test(\"Incluye el resultado registrado\", () => pm.expect(a.resultado.puntaje).to.eql(85.5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/asignaciones/{{asignacionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "asignaciones",
                "{{asignacionId}}"
              ]
            }
          }
        }
      ]
    },
