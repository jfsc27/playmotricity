    {
      "name": "4. Módulo Registro de Resultados",
      "item": [
        {
          "name": "Registrar resultado en progreso (completada: false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
