                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Existen actividades cargadas\", () => pm.expect(res.length).to.be.at.least(1));",
                  "pm.environment.set(\"actividadId\", res[0].id);"
                ]
