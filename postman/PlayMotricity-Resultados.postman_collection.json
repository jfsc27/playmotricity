        },
        {
          "name": "Filtrar actividades por edad (3 años)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "res.forEach(a => {",
                  "  pm.test(`Actividad ${a.nombre} adecuada para edad 3`, () => {",
                  "    pm.expect(a.edadMinima).to.be.at.most(3);",
                  "    pm.expect(a.edadMaxima).to.be.at.least(3);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actividades?edad=3",
              "host": ["{{baseUrl}}"],
              "path": ["actividades"],
              "query": [
                {
                  "key": "edad",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
