              {
                "key": "Authorization",
                "value": "Bearer {{tokenDocente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/docente/resumen",
              "host": ["{{baseUrl}}"],
              "path": ["docente", "resumen"]
            }
          }
